<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.VIBRATE" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />

    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_BROWSER" />
        </intent>
    </queries>

    <application
        android:name=".KeylineApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@drawable/ic_app_icon"
        android:label="@string/app_name"
        android:roundIcon="@drawable/ic_app_icon"
        android:supportsRtl="true"
        android:theme="@style/Theme.Keyline">

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.ThemeSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.FontSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.ThemeSettingsActivity" />

        <activity
            android:name=".settings.ThemeEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".settings.ThemeSettingsActivity" />

        <activity
            android:name=".settings.TypingSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.ClipboardSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.CredentialVaultActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".settings.TranslatorActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity"
            android:windowSoftInputMode="adjustResize" />

        <activity
            android:name=".settings.BackupSettingsActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.LanguageActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.LayoutEditorActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize"
            android:parentActivityName=".settings.LanguageActivity" />

        <activity
            android:name=".settings.DictionaryActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".settings.CropActivity"
            android:exported="false"
            android:parentActivityName=".settings.SettingsActivity" />

        <activity
            android:name=".voice.PermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.Keyline.Transparent" />

        <service
            android:name=".ime.KeyboardService"
            android:directBootAware="false"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.files"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
